{
  "name": "@attestto/cr-vc-sdk",
  "version": "0.4.0",
  "description": "SDK for issuing and verifying Verifiable Credentials in the Costa Rica SSI driving ecosystem",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run build",
    "gate-self-test": "node scripts/gate-self-test.mjs"
  },
  "keywords": [
    "verifiable-credentials",
    "ssi",
    "did",
    "costa-rica",
    "mdl",
    "driving-license",
    "json-ld",
    "w3c",
    "iso-18013-5"
  ],
  "author": "Attestto Open <open@attestto.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Attestto-com/cr-vc-sdk.git"
  },
  "homepage": "https://attestto.org",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.8.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=8.0.16",
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.23",
      "js-yaml": ">=4.3.1 <5",
      "brace-expansion@<2": ">=1.1.16 <2",
      "brace-expansion@>=2": ">=5.0.7"
    }
  },
  "gateSelfTest": {
    "workflow": ".github/workflows/ci.yml",
    "testScript": "test",
    "buildScript": "build",
    "gates": [
      {
        "name": "lint",
        "script": "lint",
        "seed": "src/__gate-self-test__.ts",
        "content": "export function seeded(): void {\n  const unused = 1\n}\n"
      },
      {
        "name": "test",
        "script": "test",
        "seed": "tests/__gate-self-test__.spec.ts",
        "content": "import { it, expect } from 'vitest'\nit('is a deliberate failure', () => { expect(1).toBe(2) })\n"
      }
    ]
  }
}
